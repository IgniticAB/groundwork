{
  "name": "@ignitic/groundwork",
  "version": "0.3.0",
  "description": "Deterministic context-engineering detector. Finds stale CLAUDE.md, missing ADR cross-links, MCP misconfigurations, secrets in repo, and other context-engineering anti-patterns. No LLM required.",
  "keywords": [
    "context-engineering",
    "claude-code",
    "cursor",
    "agents-md",
    "ai-coding",
    "linter",
    "ci"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "groundwork": "bin/groundwork.mjs"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "!dist/test",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgniticAB/groundwork.git",
    "directory": "cli"
  },
  "homepage": "https://igniticab.github.io/groundwork/",
  "bugs": {
    "url": "https://github.com/IgniticAB/groundwork/issues"
  }
}
